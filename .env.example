# Canonical URL used for SEO (sitemap, JSON-LD, Open Graph). Set once the domain is live.
NEXT_PUBLIC_SITE_URL=https://frankiesjamaica.com

# Optional: email a backup copy of every order via Resend (https://resend.com).
# Off unless set to "true".
ORDER_EMAIL_ENABLED=false
RESEND_API_KEY=
ORDER_EMAIL_TO=info@frankiesjamaica.com
# Must be on a domain verified in Resend, e.g. "FRANKIES Orders <orders@frankiesjamaica.com>"
ORDER_EMAIL_FROM=
